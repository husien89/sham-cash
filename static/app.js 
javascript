class App {
    constructor() {
        this.init();
    }

    init() {
        if (!auth.isAuthenticated()) {
            window.location.href = 'login.html';
            return;
        }
        const user = auth.getCurrentUser();
        this.renderTransactions();
        this.updateBalance();
    }

    renderTransactions() {
        const list = document.getElementById('transactions-list');
        if (!list) return;
        list.innerHTML = dataManager.transactions.map(tx => `
            <div class="tx-card">
                <div class="tx-info">
                    <h4>${tx.name}</h4>
                    <small>${tx.date}</small>
                </div>
                <div class="tx-amount ${tx.type === 'in' ? 'tx-in' : 'tx-out'}">
                    ${tx.type === 'in' ? '+' : '-'} $${Math.abs(tx.amount)}
                </div>
            </div>
        `).join('');
    }

    updateBalance() {
        let total = 0;
        dataManager.transactions.forEach(t => {
            total += (t.type === 'in' ? 1 : -1) * t.amount;
        });
        document.getElementById('balance-display').textContent = `$ ${total.toFixed(2)}`;
    }

    showQR() {
        const user = auth.getCurrentUser();
        const modal = document.getElementById('qr-modal');
        const usernameDisplay = document.getElementById('qr-username');
        const canvas = document.getElementById('qr-canvas');

        usernameDisplay.textContent = user.name;
        
        // توليد QR كود حقيقي باسم المستخدم و ID[1]
        const qrData = `${user.name} - ${user.username}`;
        QRCode.toCanvas(canvas, qrData, { width: 200 }, (error) => {
            if (error) console.error(error);
            modal.style.display = 'flex';
        });
    }
}

const app = new App();